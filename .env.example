# ── Backend (Flask) ──────────────────────────────
# Sin DATABASE_URL se usa SQLite en src/instance/techdrop.db (se siembra sola con el catálogo).
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/techdrop
FLASK_APP=src/app.py
FLASK_DEBUG=1
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Crea un administrador al arrancar (opcional):
# ADMIN_EMAIL=tu@email.com
# ADMIN_PASSWORD=una-contraseña-segura
# Orígenes permitidos para la API, separados por comas (por defecto *):
# CORS_ORIGINS=http://localhost:3000

# ── Frontend (Vite) ──────────────────────────────
# Sin VITE_BACKEND_URL la tienda funciona en modo demo local (sin servidor).
# VITE_BACKEND_URL=http://localhost:3001
